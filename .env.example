# Anthropic API key — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Telegram bot (optional — leave token empty to disable bot entirely) ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Comma-separated chat_ids allowed to use the bot. Empty = bot ignores everyone
# (find your chat_id by sending any message to the bot, then look in logs/app.log).
TELEGRAM_ALLOWED_CHAT_IDS=
