# Anthropic API key — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# --- Какие модули запускать (единый entrypoint `python -m app`) --------------
# Оба по умолчанию true. Бот в любом случае не стартует без TELEGRAM_BOT_TOKEN.
#   ENABLE_WEB=true  ENABLE_BOT=true   → веб + бот
#   ENABLE_WEB=true  ENABLE_BOT=false  → только веб
#   ENABLE_WEB=false ENABLE_BOT=true   → только бот (без uvicorn)
ENABLE_WEB=false
ENABLE_BOT=true

# --- Telegram bot (optional — leave token empty to disable bot entirely) ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=

# Telegram user_id админа: ему приходят inline-кнопки одобрить/отклонить
# для каждого нового чата. Сам админ всегда считается approved (bootstrap).
# Узнать свой id можно у @userinfobot или через /whoami в собственном боте.
TELEGRAM_ADMIN_ID=

# @handle бота (без @). Используется в системном промте для ссылок типа
# https://t.me/<username>. Если не задано — fallback «wanbot».
TELEGRAM_BOT_USERNAME=

# Секрет для подписания cookie веб-сессий. Если пусто — сгенерится случайный
# при старте, но тогда сессии не переживают рестарт. Сгенерировать длинный:
#   python -c 'import secrets; print(secrets.token_urlsafe(48))'
WEB_SESSION_SECRET=

# URL Prometheus-эндпоинта telemt-прокси (например, http://x.x.x.x:9090/metrics).
# Если пусто — страница /telemt и команда /telemt в боте отключены.
TELEMT_METRICS_URL=

# Опционально: переопределить базу Open Trivia DB (для /trivia). По умолчанию
# https://opentdb.com — публичный, без ключа. Менять имеет смысл только для
# своего локального прокси/миррора.
TRIVIA_API_URL=

# Google Gemini API key — нужен ТОЛЬКО для генерации картинок («нарисуй …»).
# Если пусто — скилл генерации отключён (отвечает понятной ошибкой), остальное
# работает. Взять: https://aistudio.google.com/apikey (кнопка Create API key).
# Важно: image-генерация в бесплатный tier НЕ входит — в привязанном Google
# Cloud проекте нужно включить биллинг, иначе запрос вернёт ошибку quota.
GEMINI_API_KEY=

# Модель генерации картинок. Пусто → дефолт gemini-3.1-flash-image.
# Безопасно ставить ТОЛЬКО *-image модели Gemini (метод generateContent),
# код заточен под них:
#   gemini-3.1-flash-image  — дефолт: новее, лучше качество, ~$0.067 за 1K-картинку
#   gemini-3-pro-image      — Nano Banana Pro: максимум качества и текст на
#                             картинке, но дороже и медленнее
#   gemini-2.5-flash-image  — прошлое поколение, дешевле (~$0.039), качество ниже
# НЕ ставить модели Imagen (imagen-4.0-*): у них другой эндпоинт (:predict) и
# формат ответа, наш код их не поддержит — генерация просто перестанет работать.
GEMINI_IMAGE_MODEL=

# TMDB-ключи нужны ТОЛЬКО для скрипта scripts/fetch_movies.py, который
# одноразово грузит топ-1000 фильмов в data/movies.sqlite3. Бот в рантайме
# в TMDB не ходит — читает только локальную базу. Если SQLite-файла нет,
# игра /movie вернёт понятную ошибку, остальные игры работают как раньше.
#
# TMDB_BEARER_TOKEN — v4 Read Access Token, длинный JWT (eyJ...).
# Уходит в заголовок Authorization: Bearer ... и имеет приоритет.
# Взять: https://www.themoviedb.org/settings/api → «API Read Access Token».
TMDB_BEARER_TOKEN=

# --- Бекап баз на WebDAV (scripts/backup-db.sh) -----------------------------
# Скрипт снимает консистентный снапшот живых SQLite-баз (blackjack,
# deal_stats, llm_history, logs/chat) и заливает .tar.gz на WebDAV.
# movies/shows туда НЕ входят — это статика, переносится один раз вручную.
#
# WEBDAV_URL — каталог назначения с / на конце. Примеры:
#   Nextcloud:  https://nas.example/remote.php/dav/files/USERNAME/wanhub-backups/
#   generic:    https://dav.example/backups/wanhub/
WEBDAV_URL=
WEBDAV_USER=
# Для Nextcloud лучше app-password (Настройки → Безопасность), а не основной.
WEBDAV_PASS=
# Сколько последних архивов хранить на шаре (по умолчанию 14).
BACKUP_RETENTION=14
